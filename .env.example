# =====================================================================
# NASA Space Apps Challenge 2026 — Environment Configuration
# Copiar a `.env` (ignorado por git) y cambiar las contraseñas.
# =====================================================================

# Database Settings (PostgreSQL 18, contenedor `db`)
POSTGRES_DB=hotspots_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=cambiar_esta_clave
# Puerto publicado en 127.0.0.1. Cambiarlo si 5432 ya está en uso (p. ej. 5434).
POSTGRES_PORT=5432

# Backend Ingestion Gateway:
# - 'database': consulta PostgreSQL 18 (`harmonized.cell_month`). Si la base falla responde HTTP 503:
#               NUNCA cae a datos sintéticos.
# - 'stub': motor sintético determinístico (solo desarrollo sin base).
DATA_SOURCE_MODE=database
CELL_MONTH_USE_CELL_ID_RANGES=true

# Rol de solo lectura del backend (lo crea scripts/load_harmonized_dump.sh al cargar el .dump real).
READONLY_USER=wildfire_web
READONLY_PASS=cambiar_esta_clave_de_solo_lectura
# Conexión que usa el backend dentro de Docker (host `db`, puerto interno 5432).
# Si no se define, el backend usa POSTGRES_USER / POSTGRES_PASSWORD (solo para desarrollo).
BACKEND_DATABASE_URL=postgresql://wildfire_web:cambiar_esta_clave_de_solo_lectura@db:5432/hotspots_db
