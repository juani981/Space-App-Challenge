# =====================================================================
# NASA Space Apps Challenge 2026 — Environment Configuration
# =====================================================================

# Database Settings (PostgreSQL 18)
POSTGRES_DB=hotspots_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend Ingestion Gateway:
# - 'database': Queries PostgreSQL 18 table `hotspots` (falls back to stub if unreachable)
# - 'stub': Uses deterministic spatial grid synthetic engine
DATA_SOURCE_MODE=database
DATABASE_URL=postgresql://postgres:postgres@db:5432/hotspots_db
